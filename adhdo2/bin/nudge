#!/usr/bin/env python3
import sys, pathlib
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))

import hashlib, json, shutil, subprocess, time
from datetime import datetime
from pathlib import Path
from adhdolib import db
from adhdolib.config import load_config, home
from adhdolib.envelope import ToolArgumentParser, ToolError, cli_main
from adhdolib.nudgelimits import check_allowed

def prune_cache(cache_dir: Path, max_age: float = 86400) -> int:
    """Delete cached mp3s older than max_age seconds. Runs on every nudge
    invocation (not just on cache misses) so the cache can't grow unbounded.
    Returns the number of files removed."""
    if not cache_dir.is_dir():
        return 0
    cutoff = time.time() - max_age
    removed = 0
    for f in cache_dir.glob("*.mp3"):
        # A concurrent nudge may prune the same file between glob and
        # stat/unlink; tolerate the race instead of crashing.
        try:
            if f.stat().st_mtime < cutoff:
                f.unlink(missing_ok=True)
                removed += 1
        except FileNotFoundError:
            continue
    return removed

def synthesize(text: str, cache_dir: Path) -> Path:
    cache_dir.mkdir(parents=True, exist_ok=True)
    out = cache_dir / (hashlib.sha1(text.encode()).hexdigest()[:16] + ".mp3")
    wav = out.with_suffix(".wav")
    if out.exists():
        return out
    if shutil.which("piper"):
        subprocess.run(["piper", "--output_file", str(wav)],
                       input=text.encode(), check=True, timeout=60)
    elif shutil.which("espeak-ng"):
        subprocess.run(["espeak-ng", "--stdin", "-w", str(wav)],
                       input=text.encode(), check=True, timeout=60)
    else:
        raise ToolError("tts_failed", "neither piper nor espeak-ng found")
    if not shutil.which("ffmpeg"):
        raise ToolError("tts_failed", "ffmpeg not found for mp3 encode")
    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", str(wav), str(out)],
                   check=True, timeout=60)
    wav.unlink(missing_ok=True)
    return out

def play_url_on_device(url: str, device_name: str, cfg: dict, *, current_time=None, stream_type="LIVE"):
    import pychromecast
    casts, browser = pychromecast.get_listed_chromecasts(friendly_names=[device_name])
    try:
        if not casts:
            raise ToolError("no_devices", f"{device_name} not found")
        cc = casts[0]; cc.wait()
        kwargs = {"stream_type": stream_type}
        if current_time is not None:
            kwargs["current_time"] = current_time
        cc.media_controller.play_media(url, "audio/mpeg", **kwargs)
        cc.media_controller.block_until_active(timeout=15)
    finally:
        browser.stop_discovery()

def wait_until_idle(device_name: str, cfg: dict, timeout: int = 30, *, expected_url=None) -> bool:
    """Poll the device's media_controller.status every second until the
    player is IDLE or timeout elapses. Returns True if it became
    idle, False on timeout. Module-level so tests can monkeypatch it."""
    try:
        import pychromecast
    except ImportError:
        return False
    casts, browser = pychromecast.get_listed_chromecasts(friendly_names=[device_name])
    try:
        if not casts:
            return False
        cc = casts[0]
        cc.wait(timeout=5)
        deadline = time.time() + timeout
        while time.time() < deadline:
            s = cc.media_controller.status
            state = getattr(s, "player_state", None)
            if expected_url and getattr(s, "content_id", None) != expected_url:
                return False  # another sender took over, or status is unknown
            if state == "IDLE":
                return True
            time.sleep(1)
        return False
    finally:
        browser.stop_discovery()

def _interrupted_playback(device_name):
    """Snapshot only cast-owned content actively playing on the nudge target."""
    np = home() / "data" / "now_playing.json"
    try:
        info = json.loads(np.read_text())
    except (OSError, ValueError):
        return None
    if not info.get("url") or info.get("device") != device_name:
        return None
    import pychromecast
    casts, browser = pychromecast.get_listed_chromecasts(friendly_names=[device_name])
    try:
        if not casts:
            return None
        cc = casts[0]; cc.wait(timeout=5)
        status = cc.media_controller.status
        if (getattr(status, "player_state", None) != "PLAYING"
                or getattr(status, "content_id", None) != info["url"]):
            np.unlink(missing_ok=True)
            return None
        position = (None if getattr(status, "stream_type", None) == "LIVE"
                    else getattr(status, "current_time", None))
        return info, position, getattr(status, "stream_type", "LIVE")
    finally:
        browser.stop_discovery()


def _resume_previous(cfg, interrupted) -> bool:
    if interrupted is None:
        return False
    info, position, stream_type = interrupted
    # Honour a cast stop/new play issued while the nudge was speaking.
    try:
        current = json.loads((home() / "data" / "now_playing.json").read_text())
        if current != info:
            return False
        play_url_on_device(info["url"], info["device"], cfg, current_time=position,
                           stream_type=stream_type)
        return True
    except (ToolError, OSError, ValueError):
        return False

def run(argv, _test_conn=None):
    ap = ToolArgumentParser(prog="nudge")
    ap.add_argument("text")
    ap.add_argument("--device")
    ap.add_argument("--urgency", choices=["low", "med", "high"], default="low")
    ap.add_argument("--event")
    args = ap.parse_args(argv)
    cfg = load_config()
    conn = _test_conn or db.connect()
    try:
        hour_ago = time.time() - 3600
        n = conn.execute("SELECT COUNT(*) FROM events WHERE type='nudge' AND ts>?",
                         (hour_ago,)).fetchone()[0]
        ok, code = check_allowed(datetime.now(), args.urgency, args.event, n, cfg)
        if not ok:
            raise ToolError(code, "nudge blocked; do not retry this cycle")
        device = args.device or cfg["default_device"]
        if not device:
            raise ToolError("no_device_configured", "set default_device in config")
        real_name = cfg["devices"].get(device, device)
        cache_dir = home() / "tts-cache"
        prune_cache(cache_dir)
        mp3 = synthesize(args.text, cache_dir)
        url = f"http://{cfg['lan_ip']}:{cfg['httpd_port']}/{mp3.name}"
        interrupted = _interrupted_playback(real_name)
        play_url_on_device(url, real_name, cfg)
        finished = wait_until_idle(real_name, cfg, expected_url=url)
        resumed = _resume_previous(cfg, interrupted) if finished else False
        db.log_event(conn, "nudge", "nudge", json.dumps(
            {"text": args.text, "urgency": args.urgency, "device": device}))
        db.audit(conn, "nudge", argv, True, "")
        return {"nudged": True, "device": device, "resumed": resumed}
    except ToolError as e:
        db.audit(conn, "nudge", argv, False, e.code)
        raise
    except Exception as e:
        db.audit(conn, "nudge", argv, False, f"crash: {type(e).__name__}")
        raise

if __name__ == "__main__":
    cli_main(lambda: run(sys.argv[1:]))
